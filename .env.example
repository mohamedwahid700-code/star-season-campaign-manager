# Copy this file to `.env` and adjust values as needed.
# Everything here is optional -- sane defaults are used if a variable is
# not set. See app/config/app_config.py for the full list.

# production | development
APP_ENV=production

# true/false - verbose logging + SQL echo when supported
APP_DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Number of days of rotated daily log files to keep
LOG_RETENTION_DAYS=30

# SQLAlchemy connection string. Defaults to a local SQLite file under ./data
# DATABASE_URL=sqlite:///data/star_season.db

# Override any of these to relocate application folders.
# APP_DATA_DIR=./data
# APP_LOGS_DIR=./logs
# APP_TEMPLATES_DIR=./templates
# APP_REPORTS_DIR=./reports
# APP_ASSETS_DIR=./assets
